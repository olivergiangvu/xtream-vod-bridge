# Xtream VOD Unified v0.6 example — placeholders ONLY. Never commit production.env.
# Accepted HomeDocker architecture uses host nginx HTTPS :18450 and app loopback :18769.
PUBLIC_BASE_URL=https://YOUR_TRUSTED_FQDN:18450
ADMIN_PUBLIC_ORIGIN=https://YOUR_TRUSTED_FQDN:18450
ADMIN_LAN_ORIGIN=

# Legacy Xtream provider (if used). Never put credentials in URL itself.
XTREAM_BASE_URL=https://YOUR_AUTHORIZED_PROVIDER:PORT
XTREAM_USERNAME=REPLACE_ME
XTREAM_PASSWORD=REPLACE_ME

# Generate three distinct random values with: openssl rand -hex 32
ADDON_TOKEN=REPLACE_WITH_RANDOM_ADDON_SECRET
ADMIN_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_ADMIN_SECRET
PLAYBACK_SECRET=REPLACE_WITH_SEPARATE_RANDOM_PLAYBACK_SECRET

# Fernet key. Generate once: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# This MUST be restored alongside SQLite or stored source credentials cannot be decrypted.
SOURCE_SECRETS_KEY=REPLACE_WITH_PERSISTENT_FERNET_KEY
TMDB_API_KEY=

# Unified single scheduler / no separate legacy writer.
XTREAM_UNIFIED_MODE=1
LEGACY_SYNC_ENABLED=1
STREAM_SOURCE_LABEL=IPTV VOD
SYNC_HOURS=6
MAX_ENRICH_PER_SYNC=250
SERIES_ENRICH_PER_SYNC=40
SERIES_BOOTSTRAP_BATCH=0
SERIES_BOOTSTRAP_INTERVAL_MINUTES=30
SERIES_ON_DEMAND=0
SERIES_JIT_TIMEOUT_SECONDS=8
SERIES_JIT_TTL_HOURS=6
SERIES_JIT_RETRY_SECONDS=120
SERIES_JIT_MAX_VARIANTS=8
REFRESH_INFO_DAYS=30
PLAY_URL_HOURS=48
MOVIES_ONLY=0

# Secure by default. Review public-IPv4 CDN redirect policy before relaxing.
XTREAM_REDIRECT_ALLOWED_HOSTS=
XTREAM_HTTP_REDIRECT_ALLOWED_IPS=
XTREAM_HTTP_REDIRECT_MODE=allowlist
