# External HTTPS URL for the addon, including the path prefix handled by host nginx.
PUBLIC_BASE_URL=https://YOUR_DOMAIN/xtream-vod
# Provider Xtream base URL, typically http(s)://provider.example:port
XTREAM_BASE_URL=https://YOUR_AUTHORIZED_PROVIDER:PORT
XTREAM_USERNAME=REPLACE_ME
XTREAM_PASSWORD=REPLACE_ME
# Only needed if provider supplies TMDb IDs but not IMDb IDs; recommended.
TMDB_API_KEY=
# Generate with openssl rand -hex 32 (use DIFFERENT values for these 3 secrets).
ADDON_TOKEN=REPLACE_WITH_RANDOM_TOKEN
ADMIN_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_TOKEN
# Password login only works via exact HTTPS origin, on the LAN-only /admin/ route.
# Change this to match your actual verified public HTTPS origin including port.
ADMIN_PUBLIC_ORIGIN=https://YOUR_DOMAIN:18450
# Admin UI backend stays at 127.0.0.1:18768 (no WAN or LAN direct bind).
# ADMIN_TOKEN remains an emergency API credential; normal browser login uses
# a CLI-provisioned Admin password stored as a salted hash in SQLite.
# Admin UI is a separate local-only service. SSH tunnel to 127.0.0.1:18768.
BRIDGE_ADMIN_HOST_PORT=18768
# Optional default stream name; Web UI can override this in SQLite.
STREAM_SOURCE_LABEL=IPTV VOD
PLAYBACK_SECRET=REPLACE_WITH_THIRD_RANDOM_SECRET
SYNC_HOURS=6
MAX_ENRICH_PER_SYNC=250
# Per standard SYNC_HOURS run, reserve up to this many *within*
# MAX_ENRICH_PER_SYNC for Series details/episodes; remainder for Movies.
SERIES_ENRICH_PER_SYNC=40
# Optional separate Series-only bootstrap worker (0 disables).
# For 7k+ series start conservatively: 25 per 30 minutes.
# Sequential requests; checkpoint stored in existing SQLite checked_at.
SERIES_BOOTSTRAP_BATCH=0
SERIES_BOOTSTRAP_INTERVAL_MINUTES=30
# v0.3 on-demand Series resolver: opt-in for first real provider pilot.
# Cold Series fetch get_series_info only when AIOStreams asks for an episode.
SERIES_ON_DEMAND=0
SERIES_JIT_TIMEOUT_SECONDS=8
SERIES_JIT_TTL_HOURS=6
SERIES_JIT_RETRY_SECONDS=120
SERIES_JIT_MAX_VARIANTS=8
REFRESH_INFO_DAYS=30
# Playback links expire after N hours. Larger value helps long viewing sessions/queues.
PLAY_URL_HOURS=48
# 0 = movie + series (including anime series), 1 = movies only.
MOVIES_ONLY=0

# Explicitly permitted HTTPS CDN hostnames (strict HTTPS; no wildcards).
XTREAM_REDIRECT_ALLOWED_HOSTS=
# Optional emergency compatibility: HTTPS Xtream -> HTTP public IPv4 CDN only.
# Empty (default) rejects ALL HTTPS-to-HTTP redirects.
# Set ONLY after confirming the provider's redirect IP and accepting the
# unencrypted upstream HTTP video leg; canonical public IPv4 addresses only.
# Do NOT put user/password, URLs, private IPs, or wildcards here.
XTREAM_HTTP_REDIRECT_ALLOWED_IPS=
# allowlist = strict legacy policy (default), public-ip = auto accept only
# globally routable IPv4 destinations over HTTP:80 from provider 302/307.
# A public-ip mode avoids hardcoding changing CDN IPs, but means the upstream
# video leg is NOT encrypted. Enable only for a trusted authorized provider.
# Hostnames and private/loopback/link-local IPs are always blocked for HTTP.
XTREAM_HTTP_REDIRECT_MODE=allowlist
